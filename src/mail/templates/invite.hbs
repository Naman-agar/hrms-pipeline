<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>You have been invited to HRMS</title>
  </head>
  <body>
    <p>Hi {{firstName}},</p>
    <p>You have been invited to join HRMS. Click the link below to set your password and activate your account:</p>
    {{!-- inviteUrl is built server-side (FRONTEND_URL + base64url token); triple-stash keeps "=" and "&" literal --}}
    <p><a href="{{{inviteUrl}}}">{{{inviteUrl}}}</a></p>
    <p>This invitation expires in {{expiresInHours}} hours.</p>
    <p>If you were not expecting this email, you can ignore it.</p>
  </body>
</html>
