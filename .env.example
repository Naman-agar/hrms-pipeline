PORT=3000
DATABASE_URL=postgresql://hrms:hrms@localhost:5432/hrms
REDIS_URL=redis://localhost:6379
JWT_PRIVATE_KEY=            # RS256 PEM, base64-encoded single line
JWT_PUBLIC_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
INVITE_TTL_HOURS=72
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
MAIL_PROVIDER=console       # console | ses | sendgrid
MAIL_FROM=no-reply@example.com

# `npm test` runs against this database instead of DATABASE_URL
# (defaults to postgresql://hrms:hrms@localhost:5432/hrms_test when unset).
# DATABASE_URL_TEST=postgresql://hrms:hrms@localhost:5432/hrms_test
